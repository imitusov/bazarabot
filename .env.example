# Copy to .env, fill in, and chmod 600. Never commit the filled version.
# The bot refuses to start if any required value is missing (spec rule 15).

# --- Broker (required) -------------------------------------------------------
TINVEST_TOKEN=              # FULL-ACCESS token. Equivalent to a password for the account.
TINVEST_ACCOUNT_ID=         # The separate account holding ONLY the allocated capital.
TRADING_MODE=live           # live | sandbox
SSL_TBANK_VERIFY=true       # REQUIRED. T-Bank's certificate chains to the Russian
                            # Trusted Root CA, which gRPC does not ship. The SDK
                            # bundles that root but only loads it when this is
                            # true. Set false only to use the system trust store.

# --- Telegram (required) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=           # The single chat allowed to command the bot.

# --- Capital and risk --------------------------------------------------------
ALLOCATED_CAPITAL=          # In roubles. Every limit below is a percentage of this.
POSITION_SIZE_PCT=10
MAX_POSITION_PCT=20
MAX_OPEN_POSITIONS=10
STOP_LOSS_PCT=5
TAKE_PROFIT_PCT=10
MAX_HOLDING_DAYS=3
DAILY_LOSS_LIMIT_PCT=5
REENTRY_COOLDOWN_MINUTES=120

# --- Trading -----------------------------------------------------------------
WATCHLIST=                  # Comma-separated MOEX tickers, e.g. SBER,GAZP,LKOH
MOEX_CLASS_CODE=TQBR
ENABLED_STRATEGIES=ma_crossover,rsi_reversion,momentum
ML_MODEL_PATH=              # Empty disables the ML strategy.
POLL_INTERVAL_SECONDS=60

# --- Runtime -----------------------------------------------------------------
DB_PATH=/data/zarabot.db
BACKUP_DIR=/data/backups
LOG_LEVEL=INFO
TZ=Europe/Moscow
