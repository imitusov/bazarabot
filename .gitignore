# Secrets — .env holds a full-access brokerage token.
# Ignored before it exists, deliberately: a credential committed once is
# committed forever, and the only remedy is revoking it at the broker.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
# Generated by `pytest --cov --cov-report=json`, which every workflow runs
# immediately before `scripts/ci/check_coverage.py`. It was tracked until #232,
# six days stale, so a local gate run silently measured a tree that no longer
# existed — and every container test run left 415 KB of churn in the diff.
coverage.json
htmlcov/
.mypy_cache/
.ruff_cache/

# Runtime data — the live trade log and its backups belong on the server,
# not in version control.
data/
*.db
*.db-wal
*.db-shm
backups/

# Research artefacts
sandbox/cache/
sandbox/models/
*.ipynb
*.ipynb_checkpoints/

# Agent scratch — worktrees a background task checks out under the repo. They
# are full working copies, so committing one would nest the tree inside itself.
.claude/worktrees/

# OS
.DS_Store
